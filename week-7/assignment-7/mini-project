
import csv
import os
import datetime

file_path = "../data/expenses.csv"

if not os.path.exists(file_path):
    print("Error: expenses.csv not found.")
    raise SystemExit

expenses = []

with open(file_path, "r") as file:
    reader = csv.DictReader(file)

    for row in reader:
        expenses.append(row)

for expense in expenses:
    expense["amount"] = float(expense["amount"])


food_expenses = []

for expense in expenses:
    if expense["category"] == "Food":
        food_expenses.append(expense)


total = 0

for expense in food_expenses:
    total += expense["amount"]


today = datetime.datetime.now().strftime("%B %d, %Y")


with open("food_report.txt", "w") as report:
    report.write(f"Food Expense Report — generated {today}\n")

    for expense in food_expenses:
        report.write(
            f"{expense['date']}: ${expense['amount']:.2f}\n"
        )

    report.write(f"Total: ${total:.2f}\n")

print("Food expense report created successfully!")
